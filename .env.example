DEEPSEEK_API_KEY=your_deepseek_key
DEFAULT_MODEL=deepseek-v4-flash

# 高德 Web 服务 Key：后端坐标校验、逆地理编码、路线规划使用
AMAP_WEB_SERVICE_KEY=your-amap-web-service-key

# 高德 Web 端 JS API Key：前端真实地图渲染使用
VITE_AMAP_JS_KEY=your-amap-js-api-key
VITE_AMAP_SECURITY_CODE=your-amap-security-code

# Voice ASR
# baidu: use Baidu Intelligent Cloud short speech recognition.
# openai: use OpenAI-compatible audio transcription.
# sensevoice: use local FunASR SenseVoice.
ASR_PROVIDER=baidu
BAIDU_APP_ID=your-baidu-app-id
BAIDU_ASR_API_KEY=your-baidu-api-key
BAIDU_ASR_SECRET_KEY=your-baidu-secret-key
BAIDU_ASR_DEV_PID=1537
# Optional. Set this when ffmpeg is not in PATH, for example:
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_BINARY=
